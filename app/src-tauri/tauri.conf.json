{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infantry AI",
  "version": "0.1.0",
  "identifier": "com.superiorsoft.infantry",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../shell/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Infantry AI",
        "width": 1600,
        "height": 1000,
        "minWidth": 420,
        "minHeight": 520,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
