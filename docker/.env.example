# Copy to docker/.env. No secrets here: the token and keystore key are files under INFANTRY_SECRETS_DIR.
# INFANTRY_IMAGE=infantryai/infantry-ai:dev
# INFANTRY_SECRETS_DIR=./secrets
# INFANTRY_BIND=127.0.0.1
# INFANTRY_HOST_PORT=8787
# INFANTRY_REPO=/work/repo
# INFANTRY_BASE_BRANCH=main
# INFANTRY_WEB_HOSTS=agents.example.com
# INFANTRY_DOMAIN=agents.example.com      # only for: docker compose --profile tls up -d
# INFANTRY_MEM_LIMIT=2g
# Domains and URLs (empty = built-in default; docs/wiki/Settings.md#domains-and-urls):
# INFANTRY_SITE_URL=https://example.com
# INFANTRY_DOCS_URL=https://example.com/docs
# INFANTRY_DOWNLOAD_URL=https://example.com/download
# INFANTRY_UPDATE_REPO=owner/releases-repo
# INFANTRY_UPDATE_API=https://api.github.com
# INFANTRY_DOCKER_IMAGE=registry.example.com/owner/infantry-ai
# Harness API keys, if you use keys instead of an interactive login:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
