# Copy to docker/.env. No secrets here: the token and keystore key are files under AGENTHQ_SECRETS_DIR.
# AGENTHQ_IMAGE=infantryai/infantry-ai:dev
# AGENTHQ_SECRETS_DIR=./secrets
# AGENTHQ_BIND=127.0.0.1
# AGENTHQ_HOST_PORT=8787
# AGENTHQ_REPO=/work/repo
# AGENTHQ_BASE_BRANCH=main
# AGENTHQ_WEB_HOSTS=agents.example.com
# AGENTHQ_DOMAIN=agents.example.com      # only for: docker compose --profile tls up -d
# AGENTHQ_MEM_LIMIT=2g
# Harness API keys, if you use keys instead of an interactive login:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
