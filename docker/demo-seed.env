# DEMO-LOCK seed (ticket 2f154f5f, branch demo-build only). Used by docker/docker-compose.demo.yml (env_file).
# The flag is read ONCE at start-up and is not a stored setting: no token can turn it off; to change it, redeploy.
# On the first locked start the entrypoint makes $INFANTRY_DEMO_DIR a git repository, then the daemon creates the project
# "Demo project" on that directory and ONE session per seat (role:harness:model), at rest, persisted in /data. Later starts
# find the same project (by directory) and the same sessions (by project + role). To re-seed: remove the volumes.
INFANTRY_DEMO_LOCK=1
# DAEMON-PLUGINS-1: pinned, so a missing demo preset refuses everything (fail closed) instead of opening production. The
# lockdown itself is the Demo_Lock daemon plugin the image bundles (/opt/infantry/modules/official/Demo_Lock); without it
# core refuses the seated preset whole, also fail closed.
INFANTRY_POLICY=demo
INFANTRY_DEMO_DIR=/work/demo
INFANTRY_DEMO_SEATS=backend:opencode:opencode-go/beam-free,pm:opencode:opencode-go/beam-free
INFANTRY_DEMO_NOTICE=This is a demo. You have 10 turns. Try asking this agent to message the other one.
# Ticket 9bf81983: visitor turns (prompt / resume / mail_send) per client IP in a rolling window, kept in /data/demo-turns.tsv.
# Both must be positive, or there is no limit. Keep the notice's number in step with INFANTRY_DEMO_TURNS_PER_IP.
INFANTRY_DEMO_TURNS_PER_IP=10
INFANTRY_DEMO_TURN_WINDOW_HOURS=24
# The peers whose X-Forwarded-For names the visitor (comma separated; default 127.0.0.1,::1). Behind Caddy on the host,
# the container sees the docker network's gateway (e.g. 172.18.0.1), not 127.0.0.1: set it here, or every visitor
# shares one count. A header from any other peer is ignored.
# INFANTRY_DEMO_TRUSTED_PROXIES=172.18.0.1

# Values the demo preset runs with (neutral core limits/policy settings; docker-compose.yml no longer carries them).
# Sessions one session / MCP connection may grow its pod by.
INFANTRY_LIMIT_CONCURRENCY_MAX_PER_POD=2
# Sessions of the whole daemon OPEN at once, any path. A 3rd start is refused with the preset's sessionCapText.
INFANTRY_LIMIT_CONCURRENCY_MAX_SESSIONS=2
# Minutes an idle agent keeps its CLI process (and so its slot above).
INFANTRY_SESSION_KEEP_ALIVE_MINUTES=2
# Model allowlist: the one free Go model that works with the owner's opencode-go credential.
INFANTRY_ALLOWED_MODELS=opencode-go/beam-free
# Role allowlist: OFF here (empty = all roles); e.g. pm,backend narrows it.
INFANTRY_ALLOWED_ROLES=
INFANTRY_LIMIT_CONCURRENCY_MCP_MAX_SPAWNS=2
INFANTRY_LIMIT_PACING_MAX_WORKERS_CEILING=2
# Free-RAM floor (MB) for the memory-pressure warning (processes.floorMb); 256 fits a 2 GB box (ticket d6016790).
INFANTRY_PROCESSES_FLOOR_MB=256
