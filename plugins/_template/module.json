{
  "name": "Example_Starter",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Your name or company",
  "license": "NOASSERTION",
  "description": "Starter module: one tab, one interceptor and one left panel section. Copy this folder, rename it, and make it yours.",
  "dependencies": [{ "id": "Infantry_Git", "version": ">=1.0 <2" }],
  "sequence": [],
  "entry": "com.example.starter.StarterPlugin",
  "jar": "build/libs/Example_Starter.jar",
  "services": ["notifications"],
  "routes": [],
  "events": [],
  "tabs": [{ "id": "example.starter", "container": "center" }],
  "panels": [{ "id": "example.starter.side", "panel": "left" }],
  "interceptors": [{ "target": "example.starter", "name": "count", "kind": "around" }],
  "daemon": {
    "entry": "com.example.starter.daemon.StarterDaemon",
    "jar": "daemon/build/libs/Example_Starter-daemon.jar",
    "apiAtLeast": "1.0.0",
    "tools": [{ "name": "example_sessions", "action": "example.starter.read", "kind": "read", "description": "How many sessions the daemon runs." }]
  }
}
