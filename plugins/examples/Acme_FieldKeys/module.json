{
  "name": "Acme_FieldKeys",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Acme (example)",
  "license": "NOASSERTION",
  "description": "Reference config-only module (CONFIG-FIELDS-2): required, pattern/patternMessage, minLength/maxLength, visibleWhen, placeholder, a color palette and a select drawn as a dropdown. Every key is optional; an old module.json without them works unchanged.",
  "config": [
    {
      "node": "acme.fieldkeys",
      "group": "Account",
      "fields": [
        { "key": "code", "type": "text", "label": "Code", "required": true, "pattern": "[A-Z]{3}", "patternMessage": "Three capital letters", "minLength": 3, "maxLength": 3, "placeholder": "ABC" },
        { "key": "mode", "type": "select", "label": "Mode", "options": ["auto", "custom"], "default": "auto", "display": "dropdown" },
        { "key": "customText", "type": "text", "label": "Custom text", "maxLength": 40, "placeholder": "Shown when Mode is custom", "visibleWhen": { "key": "mode", "eq": "custom" } },
        { "key": "accent", "type": "color", "label": "Accent", "default": "#3B82F6", "palette": ["#3B82F6", "#10B981", "#F59E0B", "#EF4444"] }
      ]
    }
  ]
}
