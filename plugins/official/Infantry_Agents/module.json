{
  "name": "Infantry_Agents",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The left panel's agents list.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.AgentsPlugin",
  "jar": "build/libs/Infantry_Agents.jar",
  "buildOrder": 10,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.agents.daemon.AgentsDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Agents-daemon.jar",
    "apiAtLeast": "1.0.0",
    "limits": { "toolTimeoutMs": 900000 },
    "tools": [
      { "name": "agenthq_harness_status", "action": "harness.install.read", "kind": "read", "description": "Which harness CLIs are installed on the daemon's machine." }
    ]
  },
  "panels": [
    {
      "id": "infantry.agents",
      "panel": "left"
    }
  ],
  "config": [
    {
      "node": "infantry.shell.config.progressStale",
      "group": "Progress bars: stale after",
      "title": "Progress bars: stale after",
      "tab": "General",
      "order": 80,
      "keywords": [
        "progress",
        "stale",
        "minutes"
      ],
      "block": "infantry.shell.config.progressStale"
    },
    {
      "node": "infantry.shell.config.cliLocations",
      "group": "CLI locations",
      "title": "CLI locations",
      "tab": "Agents",
      "order": 100,
      "keywords": [
        "harness",
        "install",
        "path",
        "cli"
      ],
      "block": "infantry.shell.config.cliLocations"
    }
  ],
  "actions": [
    { "id": "agents.spawn", "label": "New agent", "kind": "spawn", "frames": ["new"] },
    { "id": "agents.delete", "label": "Remove an ended agent", "kind": "destructive", "frames": ["session_delete"] },
    {"id": "agents.project.set", "label": "Assign an agent to a project", "kind": "write", "frames": ["session_project"]}
  ]
}
