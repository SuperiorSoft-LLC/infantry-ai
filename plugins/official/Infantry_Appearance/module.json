{
  "name": "Infantry_Appearance",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Theme and blur: the pilot of manifest-driven settings.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.appearance.AppearancePlugin",
  "jar": "build/libs/Infantry_Appearance.jar",
  "buildOrder": 215,
  "fills": [
    "infantry.shell.theme"
  ],
  "config": [
    {
      "node": "infantry.shell.theme",
      "tab": "Appearance",
      "group": "Theme",
      "order": 10,
      "title": "Theme",
      "applies": "Applies to: the whole app, at once. The accent colours buttons, focus borders and highlights.",
      "keywords": [
        "color",
        "colour",
        "accent",
        "dark",
        "light"
      ],
      "fields": [
        {
          "key": "accent",
          "type": "select",
          "label": "Accent",
          "default": "RED",
          "order": 1,
          "scope": "device",
          "options": [
            "RED",
            "AMBER",
            "INFANTRY",
            "BLUE",
            "GREEN",
            "VIOLET",
            "TEAL"
          ],
          "optionLabels": {
            "RED": "Red (default)",
            "AMBER": "Amber",
            "INFANTRY": "Infantry red",
            "BLUE": "Blue",
            "GREEN": "Green",
            "VIOLET": "Violet",
            "TEAL": "Teal"
          }
        },
        {
          "key": "dark",
          "type": "toggle",
          "label": "Dark mode",
          "default": true,
          "order": 2,
          "scope": "device"
        }
      ]
    },
    {
      "node": "infantry.shell.theme",
      "tab": "Appearance",
      "group": "Blur",
      "order": 20,
      "title": "Blur behind dialogs",
      "applies": "Applies to: every dialog. Blurs the window behind it while it is open.",
      "keywords": [
        "dialog",
        "scrim",
        "modal"
      ],
      "fields": [
        {
          "key": "blur",
          "type": "toggle",
          "label": "Blur behind dialogs",
          "default": true,
          "scope": "device"
        }
      ]
    },
    {
      "node": "infantry.shell.theme",
      "tab": "Appearance",
      "group": "Agent avatars",
      "order": 25,
      "title": "Avatar style",
      "applies": "Applies to: every agent avatar in the app. Changes how agents look; Portrait is the default.",
      "keywords": [
        "avatar",
        "agent",
        "look",
        "mascot",
        "picture"
      ],
      "fields": [
        {
          "key": "agentAvatarStyle",
          "type": "implementation",
          "label": "Avatar style",
          "default": "portrait",
          "registry": "agent.avatar.renderers",
          "exposed": true,
          "description": "How agents look in lists, chat and the title bar. A style that is removed shows as Portrait.",
          "scope": "device"
        }
      ]
    },
    {
      "node": "infantry.shell.config.userPortrait",
      "group": "Your portrait",
      "title": "Your portrait",
      "tab": "Appearance",
      "order": 30,
      "keywords": [
        "avatar",
        "picture",
        "photo"
      ],
      "block": "infantry.shell.config.userPortrait"
    }
  ]
}
