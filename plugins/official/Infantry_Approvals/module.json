{
  "name": "Infantry_Approvals",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The questions pill: open owner questions the owner cannot see inline, one click from the asking chat.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.approvals.ApprovalsPlugin",
  "jar": "build/libs/Infantry_Approvals.jar",
  "buildOrder": 200,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.approvals.daemon.ApprovalsDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Approvals-daemon.jar",
    "apiAtLeast": "1.22.0",
    "hooks": ["approvalRules"],
    "frames": [
      { "type": "approval_rules", "action": "settings.read", "kind": "read" },
      { "type": "approval_rule_delete", "action": "settings.save", "kind": "write" }
    ]
  },
  "fills": [
    "infantry.shell.questions"
  ],
  "config": [
    {
      "node": "infantry.shell.config.toolApproval",
      "group": "Tool approval",
      "title": "Tool approval",
      "tab": "Agents",
      "order": 110,
      "keywords": [
        "permission",
        "approve",
        "tools",
        "timer",
        "timeout",
        "prompt",
        "expiry",
        "indefinite"
      ],
      "block": "infantry.shell.config.toolApproval"
    }
  ]
}
