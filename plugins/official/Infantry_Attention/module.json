{
  "name": "Infantry_Attention",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "What needs the owner.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.attention.AttentionPlugin",
  "jar": "build/libs/Infantry_Attention.jar",
  "buildOrder": 150,
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.attention.daemon.AttentionDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Attention-daemon.jar",
    "apiAtLeast": "1.24.0",
    "side": "orchestrator",
    "storage": { "adopt": ["attention", "owner_questions"] },
    "hooks": ["connected"],
    "frames": [
      { "type": "attention_list", "action": "attention.read", "kind": "read" },
      { "type": "attention_ack", "action": "attention.ack", "kind": "write" },
      { "type": "question_ask", "action": "questions.ask", "kind": "write" },
      { "type": "question_list", "action": "questions.read", "kind": "read" },
      { "type": "question_answer", "action": "questions.answer", "kind": "write" },
      { "type": "question_cancel", "action": "questions.answer", "kind": "write" }
    ],
    "routes": ["GET /attention"],
    "tools": [
      { "name": "infantry_ask", "action": "questions.ask", "kind": "write", "description": "Ask the owner to choose between options, without waiting." },
      { "name": "infantry_attention_raise", "action": "attention.raise", "kind": "write", "description": "Raise an item on the owner's attention list (kind, outcome, detail; optional ticketId / sessionId)." }
    ]
  },
  "tabs": [
    {
      "id": "infantry.attention",
      "container": "right"
    }
  ],
  "fills": [
    "infantry.shell.config.questions"
  ],
  "actions": [
    {"id": "questions.answer", "label": "Answer or dismiss a question", "kind": "write", "frames": ["question_answer", "question_cancel"]},
    {"id": "attention.ack", "label": "Acknowledge an item", "kind": "write", "frames": ["attention_ack"]}
  ]
}
