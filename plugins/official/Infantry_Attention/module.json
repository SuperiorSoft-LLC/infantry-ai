{
  "name": "Infantry_Attention",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "What needs the owner.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.attention.AttentionPlugin",
  "jar": "build/libs/Infantry_Attention.jar",
  "buildOrder": 150,
  "tabs": [
    {
      "id": "infantry.attention",
      "container": "right"
    }
  ],
  "fills": [
    "infantry.shell.config.questions"
  ],
  "actions": [
    {"id": "questions.answer", "label": "Answer or dismiss a question", "kind": "write", "frames": ["question_answer", "question_cancel"]},
    {"id": "attention.ack", "label": "Acknowledge an item", "kind": "write", "frames": ["attention_ack"]}
  ]
}
