{
  "name": "Infantry_Board",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The scrum board: the board overlay and its block types, board.pane and its sections, cards and card sections.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.board.BoardPlugin",
  "jar": "build/libs/Infantry_Board.jar",
  "buildOrder": 190,
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.board.daemon.BoardDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Board-daemon.jar",
    "apiAtLeast": "1.24.0",
    "tools": [
      { "name": "infantry_ticket_get", "action": "board.read", "kind": "read", "description": "Read ONE ticket back." },
      { "name": "infantry_ticket_files", "action": "board.files.read", "kind": "read", "description": "A ticket's changed files, or the tickets that changed a path." },
      { "name": "infantry_ticket_related_files", "action": "board.files.read", "kind": "read", "description": "The files of the tickets related to a ticket." },
      { "name": "infantry_ticket_archive", "action": "board.archive.write", "kind": "write", "description": "Archive tickets (ids, an epic, or a lane filter) out of the live board." },
      { "name": "infantry_ticket_restore", "action": "board.archive.write", "kind": "write", "description": "Restore archived tickets to the live board exactly as they were." },
      { "name": "infantry_archive", "action": "board.archive.read", "kind": "read", "description": "List, show, search or count archived tickets." },
      { "name": "infantry_epic_base", "action": "epics.save", "kind": "write", "description": "Read, set or clear ONE epic's base branch." },
      { "name": "infantry_ticket_move", "action": "board.ticket.move", "kind": "write", "description": "Move or reorder ONE ticket." },
      { "name": "infantry_agent_queue", "action": "board.ticket.move", "kind": "write", "description": "List or change ONE agent's persistent ticket queue (add, remove, move, clear)." },
      { "name": "infantry_ticket_unassign", "action": "board.ticket.move", "kind": "write", "description": "Take ONE in_progress ticket back to todo, its work kept, with a handoff note." },
      { "name": "infantry_ticket_delete", "action": "board.ticket.delete", "kind": "destructive", "description": "Delete ONE ticket." },
      { "name": "infantry_ticket_create", "action": "board.ticket.save", "kind": "write", "description": "Create a ticket (images from the caller's own files)." },
      { "name": "infantry_ticket_update", "action": "board.ticket.save", "kind": "write", "description": "Edit ONE ticket (images from the caller's own files)." },
      { "name": "infantry_board", "action": "board.read", "kind": "read", "description": "The board in one call: tickets by column with their workers." },
      { "name": "infantry_ticket_start", "action": "board.ticket.move", "kind": "write", "description": "Start ONE ticket (the board's own start), under the caller's spawn limits." },
      { "name": "infantry_ticket_comment", "action": "board.ticket.save", "kind": "write", "description": "Comment on a ticket (mails its notify list), or resolve a comment." },
      { "name": "infantry_ticket_comments", "action": "board.read", "kind": "read", "description": "Read a ticket's comments." },
      { "name": "infantry_pipeline", "action": "pipeline.read", "kind": "read", "description": "Read the project's verification pipeline." },
      { "name": "infantry_pipeline_record", "action": "pipeline.save", "kind": "write", "description": "Move a commit to a pipeline stage, or start, ping or finish a check." }
    ],
    "storage": { "adopt": ["pipeline_config", "pipeline_entries", "pipeline_checks"] },
    "frames": [
      { "type": "ticket_list", "action": "board.read", "kind": "read" },
      { "type": "ticket_get", "action": "board.read", "kind": "read" },
      { "type": "ticket_save", "action": "board.ticket.save", "kind": "write" },
      { "type": "ticket_link", "action": "board.ticket.save", "kind": "write" },
      { "type": "ticket_unlink", "action": "board.ticket.save", "kind": "write" },
      { "type": "ticket_move", "action": "board.ticket.move", "kind": "write" },
      { "type": "ticket_unassign", "action": "board.ticket.move", "kind": "write" },
      { "type": "agent_queue", "action": "board.ticket.move", "kind": "write" },
      { "type": "ticket_reorder", "action": "board.ticket.move", "kind": "write" },
      { "type": "ticket_delete", "action": "board.ticket.delete", "kind": "destructive" },
      { "type": "ticket_start_next", "action": "board.ticket.start", "kind": "spawn" },
      { "type": "epic_list", "action": "epics.read", "kind": "read" },
      { "type": "epic_save", "action": "epics.save", "kind": "write" },
      { "type": "epic_base", "action": "epics.save", "kind": "write" },
      { "type": "story_get", "action": "stories.read", "kind": "read" },
      { "type": "story_list", "action": "stories.read", "kind": "read" },
      { "type": "story_save", "action": "stories.save", "kind": "write" },
      { "type": "story_move", "action": "stories.save", "kind": "write" },
      { "type": "pipeline_config", "action": "pipeline.save", "kind": "write" },
      { "type": "pipeline_show", "action": "pipeline.read", "kind": "read" },
      { "type": "pipeline_record", "action": "pipeline.save", "kind": "write" },
      { "type": "pipeline_check", "action": "pipeline.save", "kind": "write" }
    ]
  },
  "fills": [
    "infantry.shell.board"
  ],
  "panels": [
    { "id": "infantry.board.button", "panel": "left.board" }
  ],
  "blockTypes": [
    {"type": "board.pane", "title": "Board", "takesChildren": true, "fields": [
      {"key": "columns", "type": "multiSelect", "label": "Columns", "default": ["backlog", "todo", "in_progress", "pending", "done"], "options": ["backlog", "todo", "in_progress", "pending", "done"]}
    ]},
    {"type": "board.filters", "title": "Board filters", "parents": ["board.pane"], "fields": [
      {"key": "showStartNext", "type": "checkbox", "label": "Show Start next", "default": true}
    ]},
    {"type": "board.unassigned", "title": "Unassigned note", "parents": ["board.pane"]},
    {"type": "board.newTicket", "title": "New ticket form", "parents": ["board.pane"], "max": 1},
    {"type": "board.empty", "title": "Empty board", "parents": ["board.pane"]},
    {"type": "board.columns", "title": "Board columns", "takesChildren": true, "parents": ["board.pane"], "max": 1},
    {"type": "board.card", "title": "Ticket card", "takesChildren": true, "parents": ["board.columns"], "template": true},
    {"type": "board.card.summary", "title": "Card summary", "takesChildren": true, "parents": ["board.card"]},
    {"type": "board.card.title", "title": "Card title", "parents": ["board.card.summary"]},
    {"type": "board.card.badges", "title": "Card badges", "parents": ["board.card.summary"]},
    {"type": "board.card.details", "title": "Card details", "parents": ["board.card.summary"]},
    {"type": "board.card.note", "title": "Card note", "parents": ["board.card"]},
    {"type": "board.card.edit", "title": "Card edit form", "parents": ["board.card"]},
    {"type": "board.card.actions", "title": "Card actions", "parents": ["board.card"]}
  ],
  "actions": [
    { "id": "board.ticket.save", "label": "New or edit a ticket", "kind": "write", "frames": ["ticket_save", "ticket_link", "ticket_unlink"] },
    { "id": "board.ticket.move", "label": "Move or start a ticket", "kind": "write", "frames": ["ticket_move", "ticket_reorder", "ticket_unassign", "agent_queue"] },
    { "id": "board.ticket.delete", "label": "Delete a ticket", "kind": "destructive", "frames": ["ticket_delete"] },
    { "id": "board.ticket.start", "label": "Start the next ticket", "kind": "spawn", "frames": ["ticket_start_next"] },
    { "id": "images.upload", "label": "Attach an image", "kind": "write", "frames": ["image_upload"] }
  ]
}
