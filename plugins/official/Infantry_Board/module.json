{
  "name": "Infantry_Board",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The scrum board: the board overlay and its block types, board.pane and its sections, cards and card sections.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.board.BoardPlugin",
  "jar": "build/libs/Infantry_Board.jar",
  "buildOrder": 190,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.board.daemon.BoardDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Board-daemon.jar",
    "apiAtLeast": "1.4.0",
    "tools": [
      { "name": "agenthq_ticket_get", "action": "board.read", "kind": "read", "description": "Read ONE ticket back." },
      { "name": "agenthq_ticket_files", "action": "board.files.read", "kind": "read", "description": "A ticket's changed files, or the tickets that changed a path." },
      { "name": "agenthq_ticket_related_files", "action": "board.files.read", "kind": "read", "description": "The files of the tickets related to a ticket." },
      { "name": "agenthq_epic_base", "action": "epics.save", "kind": "write", "description": "Read, set or clear ONE epic's base branch." },
      { "name": "agenthq_ticket_move", "action": "board.ticket.move", "kind": "write", "description": "Move or reorder ONE ticket." },
      { "name": "agenthq_ticket_delete", "action": "board.ticket.delete", "kind": "destructive", "description": "Delete ONE ticket." },
      { "name": "agenthq_ticket_create", "action": "board.ticket.save", "kind": "write", "description": "Create a ticket (images from the caller's own files)." },
      { "name": "agenthq_ticket_update", "action": "board.ticket.save", "kind": "write", "description": "Edit ONE ticket (images from the caller's own files)." }
    ]
  },
  "fills": [
    "infantry.shell.board"
  ],
  "blockTypes": [
    {"type": "board.pane", "title": "Board", "takesChildren": true, "fields": [
      {"key": "columns", "type": "multiSelect", "label": "Columns", "default": ["backlog", "todo", "in_progress", "pending", "done"], "options": ["backlog", "todo", "in_progress", "pending", "done"]}
    ]},
    {"type": "board.filters", "title": "Board filters", "parents": ["board.pane"], "fields": [
      {"key": "showStartNext", "type": "checkbox", "label": "Show Start next", "default": true}
    ]},
    {"type": "board.unassigned", "title": "Unassigned note", "parents": ["board.pane"]},
    {"type": "board.newTicket", "title": "New ticket form", "parents": ["board.pane"], "max": 1},
    {"type": "board.empty", "title": "Empty board", "parents": ["board.pane"]},
    {"type": "board.columns", "title": "Board columns", "takesChildren": true, "parents": ["board.pane"], "max": 1},
    {"type": "board.card", "title": "Ticket card", "takesChildren": true, "parents": ["board.columns"], "template": true},
    {"type": "board.card.summary", "title": "Card summary", "takesChildren": true, "parents": ["board.card"]},
    {"type": "board.card.title", "title": "Card title", "parents": ["board.card.summary"]},
    {"type": "board.card.badges", "title": "Card badges", "parents": ["board.card.summary"]},
    {"type": "board.card.details", "title": "Card details", "parents": ["board.card.summary"]},
    {"type": "board.card.note", "title": "Card note", "parents": ["board.card"]},
    {"type": "board.card.edit", "title": "Card edit form", "parents": ["board.card"]},
    {"type": "board.card.actions", "title": "Card actions", "parents": ["board.card"]}
  ],
  "actions": [
    { "id": "board.ticket.save", "label": "New or edit a ticket", "kind": "write", "frames": ["ticket_save", "ticket_link", "ticket_unlink"] },
    { "id": "board.ticket.move", "label": "Move or start a ticket", "kind": "write", "frames": ["ticket_move", "ticket_reorder"] },
    { "id": "board.ticket.delete", "label": "Delete a ticket", "kind": "destructive", "frames": ["ticket_delete"] },
    { "id": "board.ticket.start", "label": "Start the next ticket", "kind": "spawn", "frames": ["ticket_start_next"] },
    { "id": "images.upload", "label": "Attach an image", "kind": "write", "frames": ["image_upload"] }
  ]
}
