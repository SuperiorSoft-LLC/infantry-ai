{
  "name": "Infantry_Chat",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The centre column: the agent chat, the centre tab strip and the New agent dialog.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.chat.ChatPlugin",
  "jar": "build/libs/Infantry_Chat.jar",
  "buildOrder": 200,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.chat.daemon.ChatDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Chat-daemon.jar",
    "apiAtLeast": "1.21.0",
    "frames": [
      { "type": "image_upload", "action": "images.upload", "kind": "write" }
    ],
    "tools": [
      { "name": "agenthq_inbox", "action": "mail.read", "kind": "read", "description": "List the COMMS mail addressed to you." },
      { "name": "agenthq_read", "action": "mail.read", "kind": "read", "description": "Read one message in full and mark it read." },
      { "name": "agenthq_message", "action": "mail.send", "kind": "write", "description": "Send COMMS mail to an agent, a role or a session." },
      { "name": "agenthq_chat_image", "action": "chat.image", "kind": "write", "description": "Show an image inline in a session's chat (a file inside the project, or an uploaded image id)." }
    ]
  },
  "fills": [
    "infantry.shell.center"
  ],
  "config": [
    {
      "node": "infantry.shell.config.markdownEngine",
      "group": "Markdown engine",
      "title": "Markdown engine",
      "tab": "Appearance",
      "order": 40,
      "keywords": [
        "markdown",
        "table",
        "chat",
        "format",
        "renderer"
      ],
      "block": "infantry.shell.config.markdownEngine"
    },
    {
      "node": "infantry.shell.config.reasoning",
      "group": "Agent reasoning",
      "title": "Agent reasoning",
      "tab": "Appearance",
      "order": 50,
      "keywords": [
        "reasoning",
        "thinking",
        "thought",
        "panel",
        "inline"
      ],
      "block": "infantry.shell.config.reasoning"
    }
  ],
  "actions": [
    { "id": "chat.prompt", "label": "Message an agent", "kind": "write", "frames": ["prompt"] },
    { "id": "chat.resume", "label": "Resume a session", "kind": "write", "frames": ["resume"] },
    { "id": "questions.answer", "label": "Answer or cancel a question", "kind": "write", "frames": ["question_answer", "question_cancel"] },
    { "id": "approvals.answer", "label": "Answer a tool approval", "kind": "write", "frames": ["prompt_response"] },
    { "id": "board.ticket.move", "label": "Start a ticket's session", "kind": "write", "frames": ["ticket_move"] },
    { "id": "chat.interrupt", "label": "Stop the turn", "kind": "write", "frames": ["interrupt"] },
    { "id": "agents.spawn", "label": "New agent", "kind": "spawn", "frames": ["new"] },
    { "id": "agents.swap", "label": "Switch agent", "kind": "write", "frames": ["session_swap", "agent_swap"] },
    { "id": "agents.kill", "label": "End session", "kind": "destructive", "frames": ["kill"] },
    { "id": "agents.delete", "label": "Remove agent", "kind": "destructive", "frames": ["session_delete"] },
    { "id": "agents.restart", "label": "Restart session", "kind": "destructive", "frames": ["session_restart"] },
    { "id": "host.processes.reap", "label": "Stop background processes", "kind": "destructive", "frames": ["processes_reap"] }
  ]
}
