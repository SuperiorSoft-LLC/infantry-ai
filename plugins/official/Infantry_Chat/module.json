{
  "name": "Infantry_Chat",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The centre column: the agent chat, the centre tab strip and the New agent dialog.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.chat.ChatPlugin",
  "jar": "build/libs/Infantry_Chat.jar",
