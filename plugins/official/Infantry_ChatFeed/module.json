{
  "name": "Infantry_ChatFeed",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The chat feed: the session's messages, thinking, comms cards, finished lines and automation rows, drawn by kind.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.chatfeed.ChatFeedPlugin",
  "jar": "build/libs/Infantry_ChatFeed.jar",
  "buildOrder": 210,
  "panels": [
    { "id": "infantry.chatfeed", "panel": "chat.feed" }
  ],
  "config": [
    {
      "node": "infantry.chatfeed",
      "tab": "Chat",
      "group": "Activity box",
      "order": 10,
      "title": "Activity box",
      "applies": "Applies to: the chat view's tool activity box.",
      "keywords": ["activity", "tools", "collapse"],
      "fields": [
        {
          "key": "activityBox.autoOpenWhileRunning",
          "type": "checkbox",
          "label": "Open the activity box while an agent is running",
          "default": false,
          "order": 1,
          "scope": "device"
        }
      ]
    },
    {
      "node": "infantry.chatfeed",
      "tab": "Chat",
      "group": "Long chats",
      "order": 20,
      "title": "Long chats",
      "applies": "Applies to: the chat transcript. A chat opens on its newest rows; older rows load as you scroll up.",
      "keywords": ["scroll", "page", "history", "long", "performance"],
      "fields": [
        {
          "key": "chat.pageSize",
          "type": "number",
          "label": "Rows a chat opens with (and loads per scroll-up)",
          "default": 80,
          "min": 20,
          "max": 2000,
          "step": 10,
          "order": 1,
          "scope": "device"
        }
      ]
    }
  ],
  "implementations": [
    { "registry": "chat.feed.renderers", "key": "user" },
    { "registry": "chat.feed.renderers", "key": "text" },
    { "registry": "chat.feed.renderers", "key": "reasoning" },
    { "registry": "chat.feed.renderers", "key": "status" },
    { "registry": "chat.feed.renderers", "key": "error" },
    { "registry": "chat.feed.renderers", "key": "finished" },
    { "registry": "chat.feed.renderers", "key": "log" },
    { "registry": "chat.feed.renderers", "key": "write" },
    { "registry": "chat.feed.renderers", "key": "automation" }
  ]
}
