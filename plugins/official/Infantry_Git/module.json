{
  "name": "Infantry_Git",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The project's git state.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.git.GitPlugin",
  "jar": "build/libs/Infantry_Git.jar",
  "buildOrder": 100,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.git.daemon.GitDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Git-daemon.jar",
    "apiAtLeast": "1.1.0",
    "tools": [
      { "name": "agenthq_pipeline", "action": "pipeline.read", "kind": "read", "description": "Read the project's verification pipeline." },
      { "name": "agenthq_pipeline_record", "action": "pipeline.save", "kind": "write", "description": "Move a commit to a pipeline stage, or start, ping or finish a check." }
    ]
  },
  "tabs": [
    {
      "id": "infantry.git",
      "container": "center"
    }
  ],
  "actions": [
    { "id": "project.git.checkout", "label": "Switch or create a branch", "kind": "write", "frames": ["project_git_checkout"] },
    { "id": "projects.save", "label": "Set the project directory or base branch", "kind": "write", "frames": ["project_save", "project_base"] },
    { "id": "pipeline.save", "label": "Configure the pipeline stages", "kind": "write", "frames": ["pipeline_config"] }
  ]
}
