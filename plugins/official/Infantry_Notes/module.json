{
  "name": "Infantry_Notes",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The project knowledge notes.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.notes.NotesPlugin",
  "jar": "build/libs/Infantry_Notes.jar",
  "buildOrder": 80,
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.notes.daemon.NotesDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Notes-daemon.jar",
    "apiAtLeast": "1.19.0",
    "side": "orchestrator",
    "storage": { "adopt": ["decisions", "issues", "issue_events", "memory_notes"] },
    "frames": [
      { "type": "decision_list", "action": "knowledge.read", "kind": "read" },
      { "type": "decision_get", "action": "knowledge.read", "kind": "read" },
      { "type": "decision_add", "action": "knowledge.decision.add", "kind": "write" },
      { "type": "issue_list", "action": "knowledge.read", "kind": "read" },
      { "type": "issue_get", "action": "knowledge.read", "kind": "read" },
      { "type": "issue_precheck", "action": "knowledge.read", "kind": "read" },
      { "type": "issue_open", "action": "knowledge.issue.save", "kind": "write" },
      { "type": "issue_attempt", "action": "knowledge.issue.save", "kind": "write" },
      { "type": "issue_fix", "action": "knowledge.issue.save", "kind": "write" },
      { "type": "memory_search", "action": "memory.read", "kind": "read" },
      { "type": "memory_list", "action": "memory.read", "kind": "read" },
      { "type": "memory_get", "action": "memory.read", "kind": "read" },
      { "type": "memory_save", "action": "memory.save", "kind": "write" },
      { "type": "memory_delete", "action": "memory.delete", "kind": "destructive" },
      { "type": "memory_purge_role", "action": "memory.delete", "kind": "destructive" }
    ],
    "config": [
      {
        "node": "infantry.notes", "group": "Knowledge", "title": "Notes", "tab": "Project", "order": 910,
        "applies": "Applies to: who may write or delete global notes (shared by every project on this install).",
        "keywords": ["notes", "memory", "global", "knowledge", "write"],
        "fields": [
          { "key": "knowledge.globalWriteRoles", "type": "text", "label": "Roles that may write global notes", "default": "pm", "scope": "daemon", "order": 1, "description": "Comma-separated role ids. The owner (no session) may always write. Every agent may read." }
        ]
      }
    ],
    "tools": [
      { "name": "infantry_memory", "action": "memory.read", "kind": "read", "description": "Read and write project memory notes, your role / session notes and global notes (show, search, index, write, update, delete)." }
    ]
  },
  "tabs": [
    {
      "id": "infantry.notes",
      "container": "center"
    }
  ],
  "actions": [
    {"id": "memory.save", "label": "Add or edit a note", "kind": "write", "frames": ["memory_save"]},
    {"id": "memory.delete", "label": "Delete a note", "kind": "destructive", "frames": ["memory_delete", "memory_purge_role"]}
  ]
}
