{
  "name": "Infantry_Processes",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The status bar's processes badge (free RAM, rogue processes) and its panel.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.processes.ProcessesPlugin",
  "jar": "build/libs/Infantry_Processes.jar",
  "buildOrder": 200,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.processes.daemon.ProcessesDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Processes-daemon.jar",
    "apiAtLeast": "1.8.0",
    "tools": [
      { "name": "agenthq_processes", "action": "host.processes.read", "kind": "read", "description": "List rogue background processes and free RAM." },
      { "name": "agenthq_processes_reap", "action": "host.processes.reap", "kind": "destructive", "description": "Kill one rogue process or all of them." }
    ]
  },
  "fills": [
    "infantry.shell.footer.processesBadge"
  ],
  "actions": [
    { "id": "host.processes.read", "label": "List background processes", "kind": "read", "frames": ["processes"] },
    { "id": "host.processes.reap", "label": "Reap background processes", "kind": "destructive", "frames": ["processes_reap"] },
    { "id": "settings.save", "label": "Reap rogue processes automatically", "kind": "write", "frames": ["settings_set"] }
  ]
}
