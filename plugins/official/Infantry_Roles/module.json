{
  "name": "Infantry_Roles",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Roles: who does what, and starting a session as one.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.roles.RolesPlugin",
  "jar": "build/libs/Infantry_Roles.jar",
  "buildOrder": 40,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.roles.daemon.RolesDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Roles-daemon.jar",
    "apiAtLeast": "1.1.0",
    "tools": [
      { "name": "agenthq_role_list", "action": "roles.read", "kind": "read", "description": "Every role: id, name, description, source." },
      { "name": "agenthq_role_get", "action": "roles.read", "kind": "read", "description": "One role in full, with its persona." },
      { "name": "agenthq_role_update", "action": "roles.save", "kind": "write", "description": "Update a role's persona and description." },
      { "name": "agenthq_role_create", "action": "roles.save", "kind": "write", "description": "Create a role (non-agent caller only)." },
      { "name": "agenthq_role_delete", "action": "roles.delete", "kind": "destructive", "description": "Delete or reset a role (non-agent caller only)." }
    ]
  },
  "tabs": [
    {
      "id": "infantry.roles",
      "container": "center"
    }
  ],
  "fills": [
    "infantry.shell.roles",
    "infantry.shell.config.roles"
  ],
  "actions": [
    { "id": "agents.spawn", "label": "Start a session as a profile", "kind": "spawn", "frames": ["new"] },
    { "id": "roles.save", "label": "Edit a role", "kind": "write", "frames": ["role_save", "role_binding_set", "role_traits_set"] },
    { "id": "agents.profile.save", "label": "Save a profile", "kind": "write", "frames": ["agent_save"] },
    { "id": "agents.profile.delete", "label": "Delete a profile", "kind": "destructive", "frames": ["agent_delete"] },
    {"id": "roles.delete", "label": "Delete a custom role", "kind": "destructive", "frames": ["role_delete"]}
  ]
}
