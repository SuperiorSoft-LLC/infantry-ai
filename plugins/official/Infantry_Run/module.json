{
  "name": "Infantry_Run",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Saved commands and their runs.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.run.RunPlugin",
  "jar": "build/libs/Infantry_Run.jar",
  "buildOrder": 90,
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.run.daemon.RunDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Run-daemon.jar",
    "apiAtLeast": "1.31.0",
    "frames": [
      { "type": "command_list", "action": "commands.read", "kind": "read" },
      { "type": "command_save", "action": "commands.save", "kind": "write" },
      { "type": "command_delete", "action": "commands.save", "kind": "write" },
      { "type": "run_list", "action": "runs.read", "kind": "read" },
      { "type": "run_start", "action": "runs.start", "kind": "spawn" },
      { "type": "run_attach", "action": "runs.start", "kind": "spawn" },
      { "type": "run_resize", "action": "runs.start", "kind": "spawn" },
      { "type": "run_input", "action": "runs.start", "kind": "spawn" },
      { "type": "run_stop", "action": "runs.stop", "kind": "destructive" }
    ]
  },
  "tabs": [
    {
      "id": "infantry.run",
      "container": "center"
    }
  ],
  "actions": [
    { "id": "runs.start", "label": "Run a command", "kind": "spawn", "frames": ["run_start", "run_attach", "run_resize", "run_input"] },
    { "id": "runs.stop", "label": "Stop a run", "kind": "destructive", "frames": ["run_stop"] },
    { "id": "commands.save", "label": "Add, edit or delete a saved command", "kind": "write", "frames": ["command_save", "command_delete"] }
  ]
}
