{
  "name": "Infantry_Run",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Saved commands and their runs.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.run.RunPlugin",
  "jar": "build/libs/Infantry_Run.jar",
  "buildOrder": 90,
  "tabs": [
    {
      "id": "infantry.run",
      "container": "center"
    }
  ],
  "actions": [
    { "id": "runs.start", "label": "Run a command", "kind": "spawn", "frames": ["run_start", "run_attach", "run_resize", "run_input"] },
    { "id": "runs.stop", "label": "Stop a run", "kind": "destructive", "frames": ["run_stop"] }
  ]
}
