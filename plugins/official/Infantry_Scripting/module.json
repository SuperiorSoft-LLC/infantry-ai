{
  "name": "Infantry_Scripting",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Owns the open script-engine extension point: engine plugins publish under scripting.engine/, this plugin finds them and holds the run limits.",
  "tier": "official",
  "sequence": [],
  "buildOrder": 210,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.scripting.daemon.ScriptingDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Scripting-daemon.jar",
    "apiAtLeast": "1.27.0",
    "tools": [
      { "name": "agenthq_script_run", "action": "script.run", "kind": "write", "description": "Run a named project script as the caller (the daemon runs its queued tool calls), or plan it with dryRun." },
      { "name": "agenthq_script_api", "action": "script.api", "kind": "read", "description": "Every tool a script can call (live registry), the alias table and the engine bindings." }
    ],
    "config": [
      {
        "node": "infantry.scripting", "group": "Scripting", "title": "Scripting", "tab": "Plugins", "order": 920,
        "keywords": ["script", "lua", "limits", "engine"],
        "fields": [
          { "key": "scripting.defaultEngine", "type": "text", "label": "Default engine id", "default": "lua", "scope": "daemon", "order": 1 },
          { "key": "scripting.maxSteps", "type": "number", "label": "Max steps per run", "default": 5000000, "min": 1000, "max": 1000000000, "step": 1000, "scope": "daemon", "order": 2 },
          { "key": "scripting.timeoutMs", "type": "number", "label": "Timeout per run (ms)", "default": 2000, "min": 10, "max": 600000, "step": 10, "scope": "daemon", "order": 3 },
          { "key": "scripting.maxAllocBytes", "type": "number", "label": "Max allocation per run (bytes)", "default": 67108864, "min": 65536, "max": 1073741824, "step": 65536, "scope": "daemon", "order": 4 },
          { "key": "scripting.maxPhases", "type": "number", "label": "Max re-runs per script (ih.again)", "default": 3, "min": 1, "max": 10, "step": 1, "scope": "daemon", "order": 5 },
          { "key": "scripting.aliases", "type": "text", "label": "Script aliases (JSON: short name to tool name)", "default": "{\"move\":\"agenthq_ticket_move\",\"comment\":\"agenthq_ticket_comment\",\"message\":\"agenthq_message\",\"start\":\"agenthq_ticket_start\",\"close_session\":\"agenthq_session_remove\",\"kill\":\"agenthq_kill\",\"prompt\":\"agenthq_prompt\",\"ask\":\"agenthq_ask\",\"ticket_get\":\"agenthq_ticket_get\",\"ticket_update\":\"agenthq_ticket_update\",\"ticket_create\":\"agenthq_ticket_create\",\"board\":\"agenthq_board\",\"emit\":\"agenthq_event_emit\"}", "scope": "daemon", "order": 6 }
        ]
      }
    ]
  }
}
