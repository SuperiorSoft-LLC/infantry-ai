{
  "name": "Infantry_Settings",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "Infantry AI",
  "description": "The Settings tab: groups the setup tabs (Profiles, Triggers, Notes, Run, Git) under one.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.SettingsPlugin",
  "jar": "build/libs/Infantry_Settings.jar",
  "buildOrder": 120,
  "tabs": [
    {
      "id": "infantry.settings",
      "container": "center"
    }
  ],
  "config": [
    {
      "node": "infantry.settings",
      "group": "Tabs",
      "fields": [
        {
          "key": "children.grouped",
          "type": "checkbox",
          "label": "Group the setup tabs under Settings"
        }
      ]
    }
  ]
}
