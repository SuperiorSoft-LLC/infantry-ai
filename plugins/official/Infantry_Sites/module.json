{
  "name": "Infantry_Sites",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "The Infantry AI Hosting dashboard (opened from the Services tab): your hosting servers (read-only: online or offline) with Infantry AI Hosting, and a tool for agents to list them.",
  "tier": "official",
  "dependencies": [{ "id": "Infantry_Account", "version": "^1.0" }],
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.sites.SitesPlugin",
  "jar": "build/libs/Infantry_Sites.jar",
  "buildOrder": 186,
  "services": ["daemon"],
  "routes": [
    "GET /plugins/Infantry_Sites/state",
    "POST /plugins/Infantry_Account/signin"
  ],
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.sites.daemon.SitesDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Sites-daemon.jar",
    "apiAtLeast": "1.63.0",
    "tools": [
      { "name": "infantry_sites_list", "action": "sites.servers.read", "kind": "read", "description": "List your hosting servers (id, name, status, ip, region, size, createdAt, destroyAt)." }
    ],
    "endpoints": {
      "api": {
        "prod": "https://api.superiorsoftllc.tech/api/superiorsoft",
        "dev": "http://127.0.0.1:18953/api/superiorsoft"
      },
      "site": {
        "prod": "https://superiorsoftllc.tech",
        "dev": "http://127.0.0.1:18953"
      }
    }
  },
  "tabs": [
    { "id": "infantry.sites", "container": "center" }
  ]
}
