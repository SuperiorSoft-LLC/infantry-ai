{
  "name": "Infantry_Triggers",
  "version": "1.1.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Triggers that start work on an event.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.triggers.TriggersPlugin",
  "jar": "build/libs/Infantry_Triggers.jar",
  "buildOrder": 60,
  "capabilities": [
    {
      "id": "triggers.list",
      "description": "List the triggers (optionally one kind or one project). Answers an array of triggers as the Triggers tab shows them.",
      "runs": "daemon",
      "action": "triggers.read",
      "kind": "read",
      "params": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "description": "Only this kind: manual, schedule, ship or webhook." },
          "projectId": { "type": "string", "description": "Only triggers of this project." }
        }
      },
      "result": { "type": "array" }
    },
    {
      "id": "triggers.save",
      "description": "Create (no id) or edit a trigger: {id?, name, kind (manual|schedule|ship|webhook), enabled?, action {kind: start_next|prompt, agentId?, prompt?}, intervalMs? (schedule), webhookSecret? (webhook), projectId? (prompt), coalesceMs?, ceilingRuns?, ceilingWindowMs?}. Answers the saved trigger.",
      "runs": "daemon",
      "action": "triggers.save",
      "kind": "write",
      "params": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "enabled": { "type": "boolean" },
          "action": { "type": "object" },
          "intervalMs": { "type": "integer" },
          "webhookSecret": { "type": "string" },
          "projectId": { "type": "string" },
          "coalesceMs": { "type": "integer" },
          "ceilingRuns": { "type": "integer" },
          "ceilingWindowMs": { "type": "integer" }
        },
        "required": ["name"]
      },
      "result": { "type": "object" }
    },
    {
      "id": "triggers.delete",
      "description": "Delete a trigger and its event log: {id}.",
      "runs": "daemon",
      "action": "triggers.delete",
      "kind": "destructive",
      "params": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] },
      "result": { "type": "object", "properties": { "deleted": { "type": "string" } } }
    },
    {
      "id": "triggers.fire",
      "description": "Feed one manual event to a trigger now: {id}. Coalescing, the ceiling and a trip apply as for any event. Answers the trigger after it.",
      "runs": "daemon",
      "action": "triggers.fire",
      "kind": "write",
      "params": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] },
      "result": { "type": "object" }
    }
  ],
  "daemon": {
    "entry": "com.superiorsoftllc.infantry.plugins.official.triggers.daemon.TriggersDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Triggers-daemon.jar",
    "apiAtLeast": "1.66.0",
    "side": "orchestrator",
    "storage": { "adopt": ["triggers", "trigger_events", "trigger_webhooks"] },
    "hooks": ["status"],
    "frames": [
      { "type": "trigger_save", "action": "triggers.save", "kind": "write" },
      { "type": "trigger_list", "action": "triggers.read", "kind": "read" },
      { "type": "trigger_fire", "action": "triggers.fire", "kind": "write" },
      { "type": "trigger_arm", "action": "triggers.fire", "kind": "write" },
      { "type": "trigger_disable", "action": "triggers.fire", "kind": "write" },
      { "type": "trigger_delete", "action": "triggers.delete", "kind": "destructive" },
      { "type": "trigger_events", "action": "triggers.read", "kind": "read" }
    ],
    "routes": ["POST /hooks/{id}"],
    "publicRoutes": ["POST /hooks/{id}"]
  },
  "tabs": [
    {
      "id": "infantry.triggers",
      "container": "center"
    }
  ],
  "actions": [
    { "id": "triggers.save", "label": "New or edit a trigger", "kind": "write", "frames": ["trigger_save"] },
    { "id": "triggers.fire", "label": "Fire, arm or disable a trigger", "kind": "write", "frames": ["trigger_fire", "trigger_arm", "trigger_disable"] },
    { "id": "triggers.delete", "label": "Delete a trigger", "kind": "destructive", "frames": ["trigger_delete"] }
  ]
}
