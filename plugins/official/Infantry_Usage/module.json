{
  "name": "Infantry_Usage",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Plan usage and limits.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.agenthq.plugins.official.usage.UsagePlugin",
  "jar": "build/libs/Infantry_Usage.jar",
  "buildOrder": 160,
  "daemon": {
    "entry": "com.superiorsoftllc.agenthq.plugins.official.usage.daemon.UsageDaemonPlugin",
    "jar": "daemon/build/libs/Infantry_Usage-daemon.jar",
    "apiAtLeast": "1.0.0",
    "tools": [
      { "name": "agenthq_usage", "action": "usage.read", "kind": "read", "description": "Plan usage per meter and the pacing allowance." }
    ]
  },
  "tabs": [
    {
      "id": "infantry.usage",
      "container": "right"
    }
  ],
  "fills": [
    "infantry.shell.config.limits"
  ],
  "actions": [
    { "id": "usage.set", "label": "Edit pacing", "kind": "write", "frames": ["usage_set"] }
  ]
}
