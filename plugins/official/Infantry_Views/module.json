{
  "name": "Infantry_Views",
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "description": "Draws the declarative views daemon plugins publish: the view host, the ui.* widgets and the Views tab.",
  "tier": "official",
  "sequence": [],
  "entry": "com.superiorsoftllc.infantry.plugins.official.views.ViewsPlugin",
  "jar": "build/libs/Infantry_Views.jar",
  "buildOrder": 90,
  "services": ["views"],
  "tabs": [{ "id": "infantry.views", "container": "center" }],
  "blockTypes": [
    { "type": "ui.section", "title": "Section", "takesChildren": true, "fields": [
      { "key": "title", "type": "text", "label": "Title" },
      { "key": "subtitle", "type": "text", "label": "Subtitle" },
      { "key": "collapsible", "type": "checkbox", "label": "Collapsible", "default": false } ] },
    { "type": "ui.text", "title": "Text", "fields": [
      { "key": "text", "type": "text", "label": "Text" },
      { "key": "style", "type": "select", "label": "Style", "default": "body", "options": ["body", "title", "caption", "mono"] },
      { "key": "tone", "type": "select", "label": "Tone", "default": "default", "options": ["default", "muted", "good", "warn", "bad"] },
      { "key": "maxLines", "type": "number", "label": "Max lines", "min": 1 } ] },
    { "type": "ui.badge", "title": "Badge", "fields": [
      { "key": "text", "type": "text", "label": "Text" },
      { "key": "tone", "type": "select", "label": "Tone", "default": "default", "options": ["default", "muted", "good", "warn", "bad"] } ] },
    { "type": "ui.stat", "title": "Stat", "fields": [
      { "key": "label", "type": "text", "label": "Label" },
      { "key": "value", "type": "text", "label": "Value" },
      { "key": "tone", "type": "select", "label": "Tone", "default": "default", "options": ["default", "muted", "good", "warn", "bad"] },
      { "key": "hint", "type": "text", "label": "Hint" } ] },
    { "type": "ui.unknown", "title": "Unknown widget", "fields": [ { "key": "text", "type": "text", "label": "Text" } ] }
  ]
}
