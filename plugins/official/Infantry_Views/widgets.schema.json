{
  "schema": 1,
  "widgets": 1,
  "description": "The v1 declarative-view vocabulary as data. Owned by Infantry_Views; used by the authoring lint and the example test. See docs/wiki/declarative-views.md.",
  "tones": ["default", "muted", "good", "warn", "bad"],
  "show": ["Always", "Wide", "Compact"],
  "nodeFields": ["blockType", "id", "config", "children", "fallback", "show"],
  "action": {
    "oneOf": [
      { "tool": { "name": "string", "args": "object?", "refresh": "boolean?", "toast": "boolean?" } },
      { "open": { "view": "string", "params": "object?" } }
    ]
  },
  "types": {
    "layout.column": { "children": true, "fields": { "weight": { "type": "number" }, "size": { "type": "number" } } },
    "layout.row": { "children": true, "fields": { "weight": { "type": "number" }, "size": { "type": "number" } } },
    "layout.stack": { "children": true, "fields": { "weight": { "type": "number" }, "size": { "type": "number" } } },
    "layout.group": { "children": true, "fields": { "weight": { "type": "number" }, "size": { "type": "number" } } },
    "layout.spacer": { "children": false, "fields": { "weight": { "type": "number" }, "size": { "type": "number" } } },
    "ui.section": {
      "children": true,
      "fields": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "collapsible": { "type": "boolean", "default": false }
      }
    },
    "ui.text": {
      "children": false,
      "fields": {
        "text": { "type": "string", "required": true },
        "style": { "type": "enum", "values": ["body", "title", "caption", "mono"], "default": "body" },
        "tone": { "type": "enum", "values": ["default", "muted", "good", "warn", "bad"], "default": "default" },
        "maxLines": { "type": "number" }
      }
    },
    "ui.badge": {
      "children": false,
      "fields": {
        "text": { "type": "string", "required": true },
        "tone": { "type": "enum", "values": ["default", "muted", "good", "warn", "bad"], "default": "default" }
      }
    },
    "ui.stat": {
      "children": false,
      "fields": {
        "label": { "type": "string", "required": true },
        "value": { "type": "string", "required": true },
        "tone": { "type": "enum", "values": ["default", "muted", "good", "warn", "bad"] },
        "hint": { "type": "string" }
      }
    },
    "ui.list": {
      "children": false,
      "fields": {
        "items": {
          "type": "array",
          "required": true,
          "item": {
            "id": { "type": "string", "required": true },
            "title": { "type": "string", "required": true },
            "subtitle": { "type": "string" },
            "badge": { "type": "object", "fields": {
              "text": { "type": "string", "required": true },
              "tone": { "type": "enum", "values": ["default", "muted", "good", "warn", "bad"], "default": "default" }
            } },
            "action": { "type": "action" }
          }
        },
        "empty": { "type": "string" }
      }
    },
    "ui.table": {
      "children": false,
      "fields": {
        "columns": {
          "type": "array",
          "required": true,
          "item": {
            "key": { "type": "string", "required": true },
            "label": { "type": "string", "required": true },
            "align": { "type": "enum", "values": ["start", "end"] }
          }
        },
        "rows": {
          "type": "array",
          "required": true,
          "item": {
            "id": { "type": "string", "required": true },
            "cells": { "type": "cells", "required": true },
            "action": { "type": "action" }
          }
        },
        "empty": { "type": "string" }
      }
    },
    "ui.button": {
      "children": false,
      "fields": {
        "label": { "type": "string", "required": true },
        "action": { "type": "action", "required": true },
        "style": { "type": "enum", "values": ["primary", "secondary", "danger"], "default": "secondary" },
        "confirm": { "type": "string" },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "ui.form": {
      "children": false,
      "fields": {
        "fields": { "type": "array", "required": true, "item": {} },
        "values": { "type": "object" },
        "submit": { "type": "object", "required": true, "fields": {
          "label": { "type": "string", "required": true },
          "action": { "type": "action", "required": true }
        } }
      }
    }
  }
}
