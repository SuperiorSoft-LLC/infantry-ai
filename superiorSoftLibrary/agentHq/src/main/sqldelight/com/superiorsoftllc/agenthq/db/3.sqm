-- Phase 5 -- migration v3 -> v4: pod_nodes, node_dependencies, node_attempts.
--
-- Must match nodes.sq column for column (SchemaMigrationTest compares the schemas).
--
-- NEXT MIGRATION: 4.sqm (v4 -> v5), which makes Schema.version 5.

CREATE TABLE pod_nodes (
    id TEXT NOT NULL PRIMARY KEY,
    pod_id TEXT NOT NULL REFERENCES pods(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    spec_index INTEGER NOT NULL,
    prompt TEXT NOT NULL,
    state TEXT NOT NULL,
    max_attempts INTEGER NOT NULL DEFAULT 1 CHECK (max_attempts >= 1),
    attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts >= 0),
    review_state TEXT,
    detail TEXT,
    created_at INTEGER NOT NULL,
    ended_at INTEGER,
    UNIQUE (pod_id, name)
);

CREATE INDEX index_pod_nodes_on_pod_id ON pod_nodes(pod_id);

CREATE TABLE node_dependencies (
    node_id TEXT NOT NULL REFERENCES pod_nodes(id) ON DELETE CASCADE,
    depends_on TEXT NOT NULL REFERENCES pod_nodes(id) ON DELETE CASCADE,
    PRIMARY KEY (node_id, depends_on),
    CHECK (node_id <> depends_on)
);

CREATE INDEX index_node_dependencies_on_depends_on ON node_dependencies(depends_on);

CREATE TABLE node_attempts (
    run_id TEXT NOT NULL PRIMARY KEY REFERENCES runs(id) ON DELETE CASCADE,
    node_id TEXT NOT NULL REFERENCES pod_nodes(id) ON DELETE CASCADE,
    attempt INTEGER NOT NULL CHECK (attempt >= 1),
    UNIQUE (node_id, attempt)
);
