-- TRIGGER-NUDGE -- migration v45 -> v46: a trigger knows its project, when it last fired and when it is next due, and
-- the prompt mail it is still waiting to deliver. All nullable with no default: an existing trigger reads back with no
-- project, never fired, its next due time recomputed from its interval (today's behaviour), and nothing pending.
--
-- NEXT MIGRATION: 46.sqm

ALTER TABLE triggers ADD COLUMN project_id TEXT;
ALTER TABLE triggers ADD COLUMN last_fired_at INTEGER;
ALTER TABLE triggers ADD COLUMN next_fire_at INTEGER;
ALTER TABLE triggers ADD COLUMN pending_mail_id TEXT;
