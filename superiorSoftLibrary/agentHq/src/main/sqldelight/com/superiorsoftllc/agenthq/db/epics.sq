-- MVP EPIC-3: the EPIC scopes.
--
-- WHAT AN EPIC IS: a stable id, the id of the project it belongs to, a name, its goal, and the
-- ordered list of the stories inside it. The daemon half lives in
-- com.superiorsoftllc.agenthq.epics.EpicStore; the durable surface is
-- com.superiorsoftllc.agenthq.epics.SqlEpicPersistence. The hierarchy is Project -> Epics ->
-- Stories: an epic belongs to one project, and a story hangs off an EPIC, never off the project
-- directly.
--
-- `project_id` is deliberately NOT a foreign key into `projects`: whether an epic may name a given
-- project is a rule the store owns (EpicStore.save refuses an unknown project when it is wired to a
-- ProjectStore; an unknown epic is a no-op for appendStoryId), not a constraint of this table.
-- Keeping the durable layer free of a cross-table reference is what lets the two stores be built and
-- migrated independently. The join is by id, exactly as `Project.storyIds` joins a project to its
-- stories.
--
-- `story_ids` holds the ordered JSON array of [Epic.storyIds]. The store ECHOES that list and never
-- derives it (appendStoryId maintains the order), so this layer only stores the list it is handed.
--
-- `created_at` orders the listing: `list(projectId)` answers in the order the epics were created.
-- It is stamped on insert and never touched by an edit, so a rename cannot reorder the list.

CREATE TABLE IF NOT EXISTS epics (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL,
    name TEXT NOT NULL,
    -- Free text. Empty = no goal; never null, so a client never has to tell the two apart.
    goal TEXT NOT NULL DEFAULT '',
    -- JSON array of story ids, in epic order. Empty array when the epic holds no story.
    story_ids TEXT NOT NULL DEFAULT '[]',
    created_at INTEGER NOT NULL,
    -- BASE-1c: the branch this epic's tickets cut from, overriding the project's. Empty = none set; written only
    -- by `epic_base`, which checks it resolves first.
    base_branch TEXT NOT NULL DEFAULT ''
);

-- Every epic, in creation order (ties fall back to id so the order is total and stable). The
-- per-project listing is a filter the store applies after this read, exactly as ProjectStore does.
getAllEpics:
SELECT * FROM epics ORDER BY created_at ASC, id ASC;

-- Upsert as TWO single-statement labels, because SQLDelight keeps only the FIRST statement of a
-- label and silently drops the rest: `upsert` in SqlEpicPersistence runs the insert and, when it
-- reports 0 affected rows (the id was already there), runs the update.
--
-- The insert only lands for a new id, so `created_at` keeps the row's original value and an edit
-- can never reorder the listing.
insertEpicIgnore:
INSERT OR IGNORE INTO epics(id, project_id, name, goal, story_ids, created_at, base_branch) VALUES (?, ?, ?, ?, ?, ?, ?);

-- The edit half: overwrites everything but the id and created_at.
updateEpic:
UPDATE epics SET project_id = ?, name = ?, goal = ?, story_ids = ?, base_branch = ? WHERE id = ?;
