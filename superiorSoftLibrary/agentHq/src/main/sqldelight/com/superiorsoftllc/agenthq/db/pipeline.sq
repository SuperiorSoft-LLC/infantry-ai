-- PIPE-1 -- the project PIPELINE (see 43.sqm). No pipeline_config row = no pipeline.

CREATE TABLE IF NOT EXISTS pipeline_config (
    project_id TEXT NOT NULL PRIMARY KEY,
    stages TEXT NOT NULL,
    exclusive_check INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS pipeline_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id TEXT NOT NULL,
    commit_sha TEXT NOT NULL,
    stage TEXT NOT NULL,
    moved_by TEXT,
    evidence TEXT,
    moved_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS index_pipeline_entries_on_project ON pipeline_entries(project_id, commit_sha, id);

CREATE TABLE IF NOT EXISTS pipeline_checks (
    project_id TEXT NOT NULL,
    scope TEXT NOT NULL,
    commit_sha TEXT NOT NULL,
    what TEXT NOT NULL,
    started_by TEXT,
    started_at INTEGER NOT NULL,
    last_output_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, scope)
);

getPipelineConfig:
SELECT * FROM pipeline_config WHERE project_id = ?;

upsertPipelineConfig:
INSERT OR REPLACE INTO pipeline_config(project_id, stages, exclusive_check) VALUES (?, ?, ?);

deletePipelineConfig:
DELETE FROM pipeline_config WHERE project_id = ?;

insertPipelineEntry:
INSERT INTO pipeline_entries(project_id, commit_sha, stage, moved_by, evidence, moved_at) VALUES (?, ?, ?, ?, ?, ?);

-- Newest entry first, so the first row per commit is its current stage.
getPipelineEntries:
SELECT * FROM pipeline_entries WHERE project_id = ? ORDER BY id DESC;

getPipelineChecks:
SELECT * FROM pipeline_checks WHERE project_id = ? ORDER BY started_at;

getPipelineCheck:
SELECT * FROM pipeline_checks WHERE project_id = ? AND scope = ?;

insertPipelineCheck:
INSERT INTO pipeline_checks(project_id, scope, commit_sha, what, started_by, started_at, last_output_at) VALUES (?, ?, ?, ?, ?, ?, ?);

touchPipelineCheck:
UPDATE pipeline_checks SET last_output_at = ? WHERE project_id = ? AND scope = ?;

deletePipelineCheck:
DELETE FROM pipeline_checks WHERE project_id = ? AND scope = ?;
