-- Persistence story 1/3 -- the initial migration, version 1 -> 2.
--
-- SQLDelight names a .sqm file after the version it migrates FROM, and the schema version is the
-- highest .sqm number + 1. So this file is the v1 -> v2 step, and the generated
-- AgentHQDatabase.Schema.version is 2, not 1. "Version 1" here means an :agentHq database file
-- that has no `runs` table yet.
--
-- The v2 -> v3 step is 2.sqm (Phase 4.5).
--
-- AgentHQDatabaseFactory creates a brand-new file with Schema.create() (the .sq DDL), not by
-- replaying this chain. This file runs only when something migrates FROM v1 -- which
-- SchemaMigrationTest does, to prove that 1.sqm + 2.sqm reproduce the .sq schema exactly.

-- Note that VerifyMigrationTask is disabled for this module by design (see build.gradle.kts) -- it
-- is the task that would statically prove this DDL reproduces the .sq schema, and it is disabled
-- repo-wide. Keep the two in sync by hand.

CREATE TABLE runs (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    provider TEXT NOT NULL,
    working_dir TEXT NOT NULL,
    prompt TEXT NOT NULL,
    state TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    exit_code INTEGER,
    stdout_lines INTEGER NOT NULL DEFAULT 0,
    stderr_lines INTEGER NOT NULL DEFAULT 0,
    provider_session_id TEXT,
    error TEXT
);

CREATE INDEX index_runs_on_session_id ON runs(session_id);
