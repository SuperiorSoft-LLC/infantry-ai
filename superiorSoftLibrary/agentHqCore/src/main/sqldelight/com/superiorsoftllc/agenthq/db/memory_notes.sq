-- MEM-2: the PROJECT-MEMORY note scopes.
--
-- WHAT A MEMORY NOTE IS: a durable observation scoped to exactly one project -- a stable id, the
-- project it belongs to, a name that identifies it inside that project, the folder it is filed under,
-- a one-line description and the body. The daemon half lives in
-- com.superiorsoftllc.agenthq.memory.MemoryStore (MEM-1); the durable surface is
-- com.superiorsoftllc.agenthq.memory.SqlMemoryPersistence (MEM-2).
--
-- A note is identified by its (project_id, name) pair, which MemoryStore enforces in memory; this
-- layer stores the (id) primary key and echoes the pair, so a save that updates an existing note
-- keeps its id and its created_at and an edit can never reorder the listing.
--
-- `project_id` is NOT a foreign key: a project-memory note is scoped to a project id string that the
-- caller supplies, and a note may be written before the project row itself exists. It is a plain
-- column, so no cascade is possible and none is wanted.
--
-- `created_at` orders the listing: MemoryStore.index answers in the order notes were first saved.
--
-- NOTES-1: `scope` ('project' | 'role' | 'session') and `owner_id` ('' | role id | session id) were added by 42.sqm.
-- NEXT MIGRATION: 43.sqm (this table's migration is 14.sqm, the scope columns 42.sqm)

CREATE TABLE IF NOT EXISTS memory_notes (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL,
    -- Identity inside the project; unique per project by MemoryStore, not by a table constraint.
    name TEXT NOT NULL,
    -- Folder path inside the project's memory tree; empty = the project root.
    folder TEXT NOT NULL DEFAULT '',
    -- One-line retrieval cue shown in the index; never null.
    description TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL DEFAULT '',
    -- ISO-8601 instant MemoryStore stamps on each save; echoed verbatim on read.
    updated_at TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    scope TEXT NOT NULL DEFAULT 'project',
    owner_id TEXT NOT NULL DEFAULT ''
);

CREATE INDEX IF NOT EXISTS index_memory_notes_on_project ON memory_notes(project_id, created_at);

-- Every note, in first-save order (ties fall back to id so the order is total and stable).
getAllMemoryNotes:
SELECT * FROM memory_notes ORDER BY created_at ASC, id ASC;

-- MEM-3: the notes of ONE project whose name, description or body contain a search term.
--
-- The three patterns are bound by SqlMemoryPersistence already wrapped as `%term%` (LIKE's own
-- wildcards), and the `project_id` clause is the WHOLE point: a note of another project can never
-- answer this query, so one project's memory cannot leak into another's search. Ranking is left to
-- MemoryStore -- a name/description match outranks a body-only one; this layer only narrows.
--
-- MEM-6: `ESCAPE '\'` makes the escape backslash SqlMemoryPersistence inserts before a literal `%`,
-- `_` or `\` meaningful, so a search for `%` or `_` finds the character instead of matching every note.
--
-- LIKE is deliberate for now (case-insensitive for ASCII in SQLite, and no extra native dependency).
-- FTS5 would need a build of SQLite compiled with it enabled; if that is ever justified it replaces
-- this query, and this comment is the seam to change.
searchMemoryNotes:
SELECT * FROM memory_notes
WHERE project_id = :projectId
  AND (name LIKE :namePattern ESCAPE '\' OR description LIKE :descriptionPattern ESCAPE '\' OR body LIKE :bodyPattern ESCAPE '\')
ORDER BY created_at ASC, id ASC;

-- Upsert as TWO single-statement labels, for the same reason as projects.sq: SQLDelight keeps only
-- the first statement of a label. `SqlMemoryPersistence.upsert` runs the insert and, when it reports
-- 0 affected rows (the id was already there), runs the update.
insertMemoryNoteIgnore:
INSERT OR IGNORE INTO memory_notes(id, project_id, name, folder, description, body, updated_at, created_at, scope, owner_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- The edit half: overwrites everything but the id and created_at.
updateMemoryNote:
UPDATE memory_notes SET project_id = ?, name = ?, folder = ?, description = ?, body = ?, updated_at = ?, scope = ?, owner_id = ? WHERE id = ?;

-- NOTES-1: remove one note row (purge of a session / role, or an explicit delete).
deleteMemoryNote:
DELETE FROM memory_notes WHERE id = ?;
