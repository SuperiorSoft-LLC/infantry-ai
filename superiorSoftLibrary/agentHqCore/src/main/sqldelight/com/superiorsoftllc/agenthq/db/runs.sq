-- Persistence story 1/3 -- the `runs` table, the FIRST piece of AgentHQ state to move off JSON.
--
-- WHAT A RUN IS: ONE process execution. A run is a single prompt pushed through the provider CLI.
-- Compare with session/Session.kt, whose KDoc defines the whole vocabulary: both supported CLIs are
-- one-shot, so ONE logical session is a *sequence of runs* that share one provider-side session id.
-- `runs` is therefore the CHILD table -- it records what a session actually DID, one row per
-- spawned process, and it is what makes SessionRecord.runCount mean something instead of just
-- being a counter.
--
-- Story 1 introduced this table alone. Phase 4.5 adds `pods` (pods.sq), `events` (events.sq) and
-- the pod_id column below, via 2.sqm. Phase 3's JsonSessionStore and Phase 6's Mailbox/MailRouter
-- stay on JSON on purpose: new domains go to SQLite, existing JSON stores keep running.
--
-- Minimal columns on purpose. Each one earns its place below; nothing is here "for later".

CREATE TABLE IF NOT EXISTS runs (
    -- Run id, owned by the daemon.
    id TEXT NOT NULL PRIMARY KEY,
    -- The logical session this run belongs to. INDEXED: the common read by far is "every run of a
    -- session", and it is the only column that is not a fact about the run itself.
    session_id TEXT NOT NULL,
    -- Which provider CLI ran (e.g. "opencode", "claude"). Mirrors SessionRecord.provider.
    provider TEXT NOT NULL,
    -- Absolute path the child process was launched in. Mirrors SessionRecord.workingDir.
    working_dir TEXT NOT NULL,
    -- The prompt fed to the child on stdin. Kept: without it a run row cannot be replayed or
    -- explained, and it is the smallest thing that makes a row self-describing.
    prompt TEXT NOT NULL,
    -- One of session/Session.kt SessionState, stored as TEXT and NOT as an ordinal: renaming or
    -- reordering an enum constant must never silently reinterpret an already-stored row.
    state TEXT NOT NULL,
    -- Epoch millis when the process was spawned.
    started_at INTEGER NOT NULL,
    -- Epoch millis when the process ended. NULL means "still in flight" -- which is exactly the
    -- crash-recovery question this table exists to answer after a daemon restart.
    ended_at INTEGER,
    -- Exit code of the run. NULL when it never ended (killed/in flight) or never started.
    exit_code INTEGER,
    -- Output volume per run, so a client can report a run without replaying its whole stream.
    stdout_lines INTEGER NOT NULL DEFAULT 0,
    stderr_lines INTEGER NOT NULL DEFAULT 0,
    -- The provider's own session handle as observed on the stream, if any. This is the single field
    -- that makes RESUME possible, so it is captured on the run row too and not only on the session.
    provider_session_id TEXT,
    -- Daemon-side failure for this run (e.g. the process could not be started). NULL on success.
    error TEXT,
    -- Phase 4.5: the pod (orchestration unit, see pods.sq) this run belongs to. NULL for a run that
    -- is not part of any pod -- every run the Phase 3 session path spawns today. LAST on purpose:
    -- 2.sqm adds it with ALTER TABLE ... ADD COLUMN, which always appends, so keeping it last here
    -- makes a migrated file and a freshly created one column-for-column identical (asserted by
    -- SchemaMigrationTest). CASCADE: deleting a pod deletes its runs, and through events.sq their events.
    pod_id TEXT REFERENCES pods(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS index_runs_on_session_id ON runs(session_id);

-- "Every run of a pod" is the orchestrator's main read (DAG scheduling, review queue).
CREATE INDEX IF NOT EXISTS index_runs_on_pod_id ON runs(pod_id);

-- STARTS a run: the daemon inserts the row when it spawns the process, before any output exists.
-- A re-applied spawn (or a retried write after a crash) must not duplicate a row, so this is an
-- UPSERT: insert if new, otherwise overwrite every column in place.
--
-- WHY NOT `INSERT OR REPLACE` (story 1's form): REPLACE resolves the conflict by DELETING the old
-- row and inserting a new one. Since Phase 4.5 `events.run_id` is a foreign key with ON DELETE
-- CASCADE, so a REPLACE of a run would silently wipe that run's whole event log. And `ON CONFLICT
-- DO UPDATE` needs the sqlite-3-24+ dialect, which this module does not use. INSERT OR IGNORE +
-- UPDATE in one grouped statement keeps the row identity (and its events) and the 3.18 dialect.
insertRun {
    INSERT OR IGNORE INTO runs(
        id, session_id, provider, working_dir, prompt, state,
        started_at, ended_at, exit_code, stdout_lines, stderr_lines, provider_session_id, error, pod_id
    ) VALUES (
        :id, :session_id, :provider, :working_dir, :prompt, :state,
        :started_at, :ended_at, :exit_code, :stdout_lines, :stderr_lines, :provider_session_id, :error, :pod_id
    );
    UPDATE runs SET
        session_id = :session_id,
        provider = :provider,
        working_dir = :working_dir,
        prompt = :prompt,
        state = :state,
        started_at = :started_at,
        ended_at = :ended_at,
        exit_code = :exit_code,
        stdout_lines = :stdout_lines,
        stderr_lines = :stderr_lines,
        provider_session_id = :provider_session_id,
        error = :error,
        pod_id = :pod_id
    WHERE id = :id;
}

-- One run by its id.
getRunById:
SELECT * FROM runs WHERE id = ?;

-- Every run of one logical session, oldest first -- "what did this session do, in order".
getRunsBySessionId:
SELECT * FROM runs WHERE session_id = ? ORDER BY started_at ASC;

-- Every run still in flight, i.e. started but never ended. The restart-reconciliation query.
getUnfinishedRuns:
SELECT * FROM runs WHERE ended_at IS NULL;

-- CLOSES a run out: outcome, output volume, and the provider session id if the stream revealed it.
finishRun:
UPDATE runs SET
    state = ?,
    ended_at = ?,
    exit_code = ?,
    stdout_lines = ?,
    stderr_lines = ?,
    provider_session_id = ?,
    error = ?
WHERE id = ?;

-- Marks every still-open run as ended without an exit code. The daemon calls this on startup to
-- reconcile rows left open by a previous daemon that died -- a run cannot be in flight if the
-- process that owned it is gone.
markUnfinishedRunsEnded:
UPDATE runs SET ended_at = ? WHERE ended_at IS NULL;

-- Every run of one pod, oldest first.
getRunsByPodId:
SELECT * FROM runs WHERE pod_id = ? ORDER BY started_at ASC;

-- Crash recovery for ONE run: closes it as ORPHANED (or whatever state the caller passes) without
-- touching its counts, exit code or provider session id -- unlike finishRun, which overwrites them.
-- Guarded on `ended_at IS NULL` so it can never rewrite a run that did end.
orphanRun:
UPDATE runs SET state = ?, ended_at = ?, error = ? WHERE id = ? AND ended_at IS NULL;

deleteRun:
DELETE FROM runs WHERE id = ?;

deleteRunsBySessionId:
DELETE FROM runs WHERE session_id = ?;
