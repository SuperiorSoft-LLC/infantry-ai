#!/bin/sh
# Infantry AI CLI launcher (`infantry`; same program as `agenthq`, kept as its alias) shipped with the INSTALLED app (CLIPATH-2).
# jpackage layout: <app>/resources/agenthq (this file), <app>/*.jar (the app classpath, :agentHq included), and the
# bundled runtime at ../../runtime (Linux: lib/runtime) or ../../runtime/Contents/Home (macOS: Contents/runtime).
# The daemon puts this directory first on every session's PATH and exports it as AGENTHQ_BIN.
# java: AGENTHQ_JAVA, then the bundled runtime's java, then JAVA_HOME, then java on PATH.
here=$(cd "$(dirname "$0")" && pwd)
app="$here/.."
for java in "$AGENTHQ_JAVA" "$here/../../runtime/bin/java" "$here/../../runtime/Contents/Home/bin/java" "${JAVA_HOME:+$JAVA_HOME/bin/java}"; do
  if [ -n "$java" ] && [ -x "$java" ]; then
    exec "$java" -cp "$app/*" com.superiorsoftllc.agenthq.cli.CliMainKt "$@"
  fi
done
exec java -cp "$app/*" com.superiorsoftllc.agenthq.cli.CliMainKt "$@"
