<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Rotation/resize must not recreate the activity: the controller owns a live WebSocket. -->
        <activity
            android:name="com.superiorsoftllc.agenthq.ui.shell.AgentHqActivity"
            android:exported="true"
            android:label="AgentHQ"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
    </application>
</manifest>
