#!/bin/sh
# Infantry AI server launcher and updater (SERVER-UPDATE-2).
#   infantry [serve] [daemon args]   run the daemon under a supervisor: an update restarts it into the new version
#   infantry update [--check-only] [--yes]   check for a newer release, show the notes, install it
#   infantry rollback                switch back to the version before the current one
#   infantry version
# The install is <root>/versions/<x.y.z>/ plus <root>/current (the version to start) and <root>/previous (for rollback).
# This file is also copied to <root>/infantry; there it only hands over to the current version's copy, so an update never
# rewrites a script that is running. The data dir (INFANTRY_STATE_DIR) is never touched.
SELF_DIR=$(cd "$(dirname "$0")" && pwd -P) || exit 1

# Root stub: <root>/infantry reads <root>/current and hands over.
if [ -d "$SELF_DIR/versions" ] && [ -f "$SELF_DIR/current" ]; then
    CUR=$(tr -d '\r\n' < "$SELF_DIR/current")
    if [ ! -x "$SELF_DIR/versions/$CUR/bin/infantry" ]; then
        echo "infantry: version '$CUR' named in $SELF_DIR/current is not installed" >&2
        exit 1
    fi
    INFANTRY_INSTALL_ROOT="$SELF_DIR"
    export INFANTRY_INSTALL_ROOT
    exec "$SELF_DIR/versions/$CUR/bin/infantry" "$@"
fi

APP_HOME=$(cd "$SELF_DIR/.." && pwd -P) || exit 1
if [ -x "$APP_HOME/runtime/bin/java" ]; then
    JAVA="$APP_HOME/runtime/bin/java"
elif [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi
run_cli() {
    "$JAVA" -Xmx256m -Djava.awt.headless=true -cp "$APP_HOME/lib/*" com.superiorsoftllc.infantry.update.ServerUpdateCliKt "$@"
}

# A freshly unpacked archive: copy it to <parent>/versions/<v>, then run from there.
PARENT=$(dirname "$APP_HOME")
if [ "$(basename "$PARENT")" != "versions" ]; then
    INFANTRY_APP_HOME="$APP_HOME"
    export INFANTRY_APP_HOME
    run_cli adopt "$APP_HOME" || exit $?
    exec "$PARENT/infantry" "$@"
fi

ROOT=$(dirname "$PARENT")
INFANTRY_INSTALL_ROOT="$ROOT"
INFANTRY_APP_HOME="$APP_HOME"
export INFANTRY_INSTALL_ROOT INFANTRY_APP_HOME

case "$1" in
    update|rollback) run_cli "$@"; exit $? ;;
    version|--version) cat "$APP_HOME/VERSION" 2>/dev/null; exit 0 ;;
    serve) shift ;;
esac

# Supervisor: run the version named by <root>/current; exit code 75 means "start again" (an update was staged).
# A new version that dies within 30 seconds of the switch is rolled back, once.
CHILD=
trap 'kill -TERM "$CHILD" 2>/dev/null; wait "$CHILD" 2>/dev/null; exit 143' TERM INT
LAST=
ROLLED_BACK=0
while :; do
    CUR=$(tr -d '\r\n' < "$ROOT/current")
    DIR="$ROOT/versions/$CUR"
    START=$(date +%s)
    INFANTRY_SUPERVISED=1 INFANTRY_APP_HOME="$DIR" "$DIR/bin/infantry-server.sh" "$@" &
    CHILD=$!
    wait "$CHILD"
    CODE=$?
    CHILD=
    if [ "$CODE" = 75 ]; then
        echo "[infantry] restarting into the staged version" >&2
        LAST="$CUR"
        continue
    fi
    ELAPSED=$(( $(date +%s) - START ))
    if [ "$CODE" != 0 ] && [ "$ELAPSED" -lt 30 ] && [ "$ROLLED_BACK" = 0 ] && [ -n "$LAST" ] && [ "$LAST" != "$CUR" ] && [ -f "$ROOT/previous" ]; then
        echo "[infantry] $CUR exited $CODE within 30s of the update; rolling back to $(tr -d '\r\n' < "$ROOT/previous")" >&2
        if run_cli rollback; then
            ROLLED_BACK=1
            LAST="$CUR"
            continue
        fi
    fi
    exit "$CODE"
done
