<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MOBILE-ANDROID-1: the daemon speaks cleartext ws:// (Tailscale/WireGuard carries the encryption). -->
    <!-- RELEASE-ANDROID-1: allowBackup=false (MOBILE-CONNECT-1) - the stored token is Keystore-bound, so a
         restored backup could not decrypt it anyway; backing it up only spreads ciphertext. -->
    <application
        android:allowBackup="false"
        android:label="Infantry AI"
        android:theme="@style/Theme.Infantry"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- The activity is declared in infantryUiCore; the app only adds the launcher entry. -->
        <activity
            android:name="com.superiorsoftllc.infantry.ui.shell.InfantryActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
