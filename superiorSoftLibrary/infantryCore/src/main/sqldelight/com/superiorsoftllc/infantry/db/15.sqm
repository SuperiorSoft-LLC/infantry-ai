-- MVP EPIC-3 -- migration v15 -> v16: epics survive a daemon restart.
--
-- 14.sqm added `memory_notes` (v14 -> v15); this is the very next step, adding the `epics` table
-- that com.superiorsoftllc.infantry.epics.SqlEpicPersistence writes through. A database written by
-- the previous build reaches v15 WITHOUT this table, so only an explicit migration step adds it --
-- see the same reasoning in 7.sqm for `projects`.
--
-- NEXT MIGRATION: 16.sqm

CREATE TABLE IF NOT EXISTS epics (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL,
    name TEXT NOT NULL,
    goal TEXT NOT NULL DEFAULT '',
    story_ids TEXT NOT NULL DEFAULT '[]',
    created_at INTEGER NOT NULL
);
