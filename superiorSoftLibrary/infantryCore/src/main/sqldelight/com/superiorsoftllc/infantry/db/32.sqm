-- P10-K6 -- migration v32 -> v33: `issues` + `issue_events`, the per-project append-only issues log
-- (docs/INFANTRY-PHASE10-KNOWLEDGE.md K-D8). New tables only: no existing row is touched. The tables, the indexes and the
-- five triggers are exactly issues.sq's, so a fresh file and a migrated one stay identical (SchemaMigrationTest compares
-- the triggers' and indexes' SQL too).
--
-- NEXT MIGRATION: 33.sqm (taken by P10-K11: ticket skill attachment)

CREATE TABLE IF NOT EXISTS issues (
    project_id TEXT NOT NULL,
    number INTEGER NOT NULL CHECK (number >= 1),
    summary TEXT NOT NULL,
    location TEXT NOT NULL DEFAULT '',
    ticket_id TEXT,
    implicit INTEGER NOT NULL DEFAULT 0 CHECK (implicit IN (0, 1)),
    opened_by_session TEXT,
    opened_by_agent TEXT,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, number)
);

CREATE TABLE IF NOT EXISTS issue_events (
    project_id TEXT NOT NULL,
    issue_number INTEGER NOT NULL,
    seq INTEGER NOT NULL CHECK (seq >= 1),
    kind TEXT NOT NULL CHECK (kind IN ('attempt', 'fix')),
    summary TEXT NOT NULL,
    outcome TEXT CHECK (
        (kind = 'attempt' AND outcome IN ('worked', 'failed', 'partial')) OR (kind = 'fix' AND outcome IS NULL)
    ),
    location TEXT,
    session_id TEXT,
    agent_id TEXT,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, issue_number, seq),
    FOREIGN KEY (project_id, issue_number) REFERENCES issues(project_id, number)
);

CREATE UNIQUE INDEX IF NOT EXISTS index_issue_events_one_fix
    ON issue_events(project_id, issue_number) WHERE kind = 'fix';

CREATE INDEX IF NOT EXISTS index_issue_events_on_session
    ON issue_events(project_id, session_id);

CREATE INDEX IF NOT EXISTS index_issues_on_session
    ON issues(project_id, opened_by_session);

CREATE TRIGGER IF NOT EXISTS issue_events_none_after_fix BEFORE INSERT ON issue_events
BEGIN
    SELECT RAISE(ABORT, 'issue is already fixed')
    WHERE EXISTS (
        SELECT 1 FROM issue_events
        WHERE project_id = new.project_id AND issue_number = new.issue_number AND kind = 'fix'
    );
END;

CREATE TRIGGER IF NOT EXISTS issues_append_only_update BEFORE UPDATE ON issues
BEGIN
    SELECT RAISE(ABORT, 'issues are append-only');
END;

CREATE TRIGGER IF NOT EXISTS issues_append_only_delete BEFORE DELETE ON issues
BEGIN
    SELECT RAISE(ABORT, 'issues are append-only');
END;

CREATE TRIGGER IF NOT EXISTS issue_events_append_only_update BEFORE UPDATE ON issue_events
BEGIN
    SELECT RAISE(ABORT, 'issue events are append-only');
END;

CREATE TRIGGER IF NOT EXISTS issue_events_append_only_delete BEFORE DELETE ON issue_events
BEGIN
    SELECT RAISE(ABORT, 'issue events are append-only');
END;
