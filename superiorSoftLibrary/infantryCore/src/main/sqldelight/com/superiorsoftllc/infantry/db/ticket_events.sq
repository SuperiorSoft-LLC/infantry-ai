-- BOARD-API-2 (DP-4b): the typed ticket events of docs/DAEMON-BOARD-API.md section 3. One row per change, written in the SAME
-- transaction as the board change (so a stored change always has its event), ordered by the global seq. A consumer (triggers,
-- the done-worker reaper, the ticket-files recorder, a plugin) has a cursor: the last seq it handled. Delivery is at-least-once:
-- the cursor moves after the listener returned, so a crash between handling and moving replays that event after a restart.
CREATE TABLE IF NOT EXISTS ticket_events (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    from_status TEXT,
    to_status TEXT,
    at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS index_ticket_events_on_ticket ON ticket_events(ticket_id, seq);

CREATE TABLE IF NOT EXISTS ticket_event_cursors (
    consumer TEXT NOT NULL PRIMARY KEY,
    last_seq INTEGER NOT NULL
);

insertEvent:
INSERT INTO ticket_events(ticket_id, kind, from_status, to_status, at) VALUES (:ticket_id, :kind, :from_status, :to_status, :at);

eventsAfter:
SELECT * FROM ticket_events WHERE seq > :after ORDER BY seq ASC LIMIT :limit;

headSeq:
SELECT COALESCE(MAX(seq), 0) FROM ticket_events;

trimBefore:
DELETE FROM ticket_events WHERE seq <= :seq;

cursorOf:
SELECT last_seq FROM ticket_event_cursors WHERE consumer = ?;

setCursor:
INSERT OR REPLACE INTO ticket_event_cursors(consumer, last_seq) VALUES (:consumer, :last_seq);
