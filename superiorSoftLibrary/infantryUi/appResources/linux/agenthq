#!/bin/sh
# Infantry AI CLI launcher shipped with the INSTALLED app (CLIPATH-2).
# jpackage layout: <app>/resources/infantry (this file), <app>/*.jar (the app classpath, :infantry included), and the
# bundled runtime at ../../runtime (Linux: lib/runtime) or ../../runtime/Contents/Home (macOS: Contents/runtime).
# The daemon puts this directory first on every session's PATH and exports it as INFANTRY_BIN.
# java: INFANTRY_JAVA, then the bundled runtime's java, then JAVA_HOME, then java on PATH.
here=$(cd "$(dirname "$0")" && pwd)
app="$here/.."
for java in "$INFANTRY_JAVA" "$here/../../runtime/bin/java" "$here/../../runtime/Contents/Home/bin/java" "${JAVA_HOME:+$JAVA_HOME/bin/java}"; do
  if [ -n "$java" ] && [ -x "$java" ]; then
    exec "$java" --add-opens=java.base/java.util=ALL-UNNAMED -cp "$app/*" com.superiorsoftllc.infantry.cli.CliMainKt "$@"
  fi
done
exec java --add-opens=java.base/java.util=ALL-UNNAMED -cp "$app/*" com.superiorsoftllc.infantry.cli.CliMainKt "$@"
